{
  "name": "@caravenas/pliego-ui",
  "version": "0.2.0",
  "description": "Librería de componentes de PliegoStack: tokens, primitivos y patrones de ingeniería editorial.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caravenas/pliego-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": "22.x"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/pliego-ui.js",
  "module": "./dist/pliego-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pliego-ui.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "scripts": {
    "tokens": "tsx scripts/build-tokens.ts",
    "predev": "npm run tokens",
    "dev": "storybook dev -p 6006",
    "prestorybook": "npm run tokens",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "pretest:a11y": "npm run build-storybook",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "pretest:touch": "npm run build-storybook",
    "test:touch": "playwright test e2e/touch-targets.spec.ts",
    "pretest:visual": "npm run build-storybook",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "ds:build": "npm run build && tsx scripts/build-design-system.ts",
    "ds:check": "npm run ds:build && playwright test e2e/design-system.spec.ts",
    "pretypecheck": "npm run tokens",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run tokens",
    "test": "vitest run",
    "test:watch": "npm run tokens && vitest",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.27.10",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-toast": "^1.3.1"
  }
}
